JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256

CLIENT_ID=bitrix_application_client_id
CLIENT_SECRET=bitrix_application_client_secret
SCOPE=crm,user_brief,pull,placement,userfieldconfig,imopenlines
SUPPORT_OPENLINE_CODE=2106d29de50818f3e0e36bd949f54f37

# Canonical application URL.
# Use the same domain in Bitrix24 application settings and in the production build.
VIRTUAL_HOST=https://app.example.com

# Frontend runtime/api URL.
# Leave empty for same-origin API in production.
NUXT_PUBLIC_API_URL=

# Optional explicit Django host whitelist.
# If empty, the application host from VIRTUAL_HOST is added automatically.
DJANGO_ALLOWED_HOSTS=app.example.com

# Optional extra CORS origins for production.
# Bitrix24 iframe origins are allowed via regex in Django settings.
CORS_ALLOWED_ORIGINS=

# Backend service URL for local dev only.
SERVER_HOST=http://api-some:8000

# Database
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=apppass
DB_HOST=database
DB_PORT=5432

# Local tunnel for development only. Not used in production.
CLOUDPUB_TOKEN=

# BUILD_TARGET dev | production
BUILD_TARGET=dev

## SYSTEM ######################################
VIRTUAL_PORT=3000
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Optional extra dev hosts for Vite, comma-separated.
NUXT_ALLOWED_HOSTS=

# Django admin panel for python api (api/admin)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=password

# RabbitMQ (queues)
ENABLE_RABBITMQ=0
RABBITMQ_USER=queue_user
RABBITMQ_PASSWORD=queue_password
RABBITMQ_PREFETCH=5
RABBITMQ_DSN=amqp://queue_user:queue_password@rabbitmq:5672/%2f

JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256

CLIENT_ID=bitrix_application_client_id
CLIENT_SECRET=bitrix_application_client_secret
SCOPE=crm,user_brief,pull,placement,userfieldconfig,imopenlines
SUPPORT_OPENLINE_CODE=2106d29de50818f3e0e36bd949f54f37

# Canonical application URL.
# Use the same domain in Bitrix24 application settings and in the production build.
VIRTUAL_HOST=https://app.example.com

# Frontend runtime/api URL.
# Leave empty for same-origin API in production.
NUXT_PUBLIC_API_URL=

# Optional explicit Django host whitelist.
# If empty, the application host from VIRTUAL_HOST is added automatically.
DJANGO_ALLOWED_HOSTS=app.example.com

# Optional extra CORS origins for production.
# Bitrix24 iframe origins are allowed via regex in Django settings.
CORS_ALLOWED_ORIGINS=

# Backend service URL for local dev only.
SERVER_HOST=http://api-some:8000

# Database
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=apppass
DB_HOST=database
DB_PORT=5432

# Local tunnel for development only. Not used in production.
CLOUDPUB_TOKEN=

# BUILD_TARGET dev | production
BUILD_TARGET=dev

# Build-time label shown on every screen (e.g. "DEV_ver2") to tell a dev
# stand apart from production. Leave unset for production builds — an empty
# value renders no badge at all.
# APP_ENV_LABEL=

# Mainsoft-billing integration (purchase Pro / issue Pro invoices in our own
# CRM at mainsoft.bitrix24.ru). Leaving MAINSOFT_BILLING_WEBHOOK unset is a
# safe default: purchase requests are still saved with status "ожидает
# отправки", nothing is sent to CRM, and the UI honestly says the invoice is
# prepared manually. Fill this in only once billing is ready to go live.
#
# Minimal set to go live: WEBHOOK (rights: crm, task, im, documentgenerator),
# MY_COMPANY_ID (mandatory — a smart invoice needs a seller) and
# NOTIFY_USER_ID. A deal is optional: leave DEAL_CATEGORY_ID empty and the
# smart invoice is issued straight to the client's company, no deal at all;
# set it and a deal is created/updated as before, with the invoice linked to
# it. Either way a tasks.task.add "control the payment" task is created once
# per request, linked back to CRM via UF_CRM_TASK.
# MAINSOFT_BILLING_WEBHOOK=https://mainsoft.bitrix24.ru/rest/<user>/<token>/
# MAINSOFT_BILLING_PORTAL_URL=https://mainsoft.bitrix24.ru
# MAINSOFT_BILLING_MY_COMPANY_ID=
# MAINSOFT_BILLING_DEAL_CATEGORY_ID=
# MAINSOFT_BILLING_STAGE_NEW=
# MAINSOFT_BILLING_STAGE_INVOICED=
# MAINSOFT_BILLING_STAGE_PAID=
# MAINSOFT_BILLING_STAGE_LOST=
# Smart-invoice stage codes (crm.item, entityTypeId 31) — on Mainsoft's own
# portal the only invoice category is id 3 (default, no categoryId needed):
# MAINSOFT_BILLING_INVOICE_STAGE_PAID=DT31_3:P
# MAINSOFT_BILLING_INVOICE_STAGE_LOST=DT31_3:D
# MAINSOFT_BILLING_RESPONSIBLE_ID=
# MAINSOFT_BILLING_INVOICE_TEMPLATE_ID=
# MAINSOFT_BILLING_NOTIFY_USER_ID=
# MAINSOFT_BILLING_TASK_RESPONSIBLE_ID=
# MAINSOFT_BILLING_TASK_GROUP_ID=
# MAINSOFT_BILLING_TASK_AUDITORS=
# MAINSOFT_BILLING_PRESET_ORG_ID=
# MAINSOFT_BILLING_PRESET_IP_ID=
# On Mainsoft's own portal the IP requisite preset is 3, not the code default
# of 2 — set it explicitly there, e.g.: MAINSOFT_BILLING_PRESET_IP_ID=3
# MAINSOFT_BILLING_FIELD_DOMAIN=
# MAINSOFT_BILLING_FIELD_MEMBER_ID=
# MAINSOFT_BILLING_FIELD_PORTAL_CODE=
# MAINSOFT_BILLING_FIELD_REQUEST=
# MAINSOFT_BILLING_FIELD_MONTHS=
# MAINSOFT_BILLING_FIELD_PAID_UNTIL=
# MAINSOFT_BILLING_FIELD_SOURCE=
# Полное описание переменных — в main/pro_purchase_crm.py.
#
# Pro pricing: Mainsoft works without VAT, so PRO_VAT_MODE defaults to "none".
# PRO_VAT_MODE=none

## SYSTEM ######################################
VIRTUAL_PORT=3000
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Optional extra dev hosts for Vite, comma-separated.
NUXT_ALLOWED_HOSTS=

# Django admin panel for python api (api/admin)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=password
